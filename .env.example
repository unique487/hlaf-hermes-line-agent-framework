# Copy this file to .env and adjust values as needed.

APP_NAME=HLAF
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- LINE Messaging API (LINE Developers Console > Messaging API) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Hermes agent brain: OpenCode Zen (https://opencode.ai/auth) ---
OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# 依序嘗試,前面的失敗就換下一個
# OPENCODE_ZEN_MODELS=big-pickle,deepseek-v4-flash-free,mimo-v2.5-free

# --- Access control ---
# 留空 = 第一個私訊官方帳號的人自動成為管理員(存到 config/allowlist.json)
# 也可直接填 LINE userId,逗號分隔
ALLOWED_LINE_USER_IDS=

# --- Desktop agent (Hermes 操控電腦的工作範圍) ---
# HERMES_DESKTOP_ROOT=G:\我的雲端硬碟\Hermes agent
# HERMES_PROGRESS_INTERVAL_SECONDS=300
# HERMES_MAX_TOOL_STEPS=25
# HERMES_CONFIRM_TIMEOUT_SECONDS=600
