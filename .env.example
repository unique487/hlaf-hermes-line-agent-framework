# Copy this file to .env and adjust values as needed.

APP_NAME=Claude
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- LINE Messaging API (LINE Developers Console > Messaging API) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Access control ---
# 留空 = 第一個私訊官方帳號的人自動成為管理員(存到 config/allowlist.json)
# 也可直接填 LINE userId,逗號分隔
ALLOWED_LINE_USER_IDS=

# --- Desktop agent (LINE 操控電腦的工作範圍,大腦是本機已登入的 Claude Code CLI) ---
# DESKTOP_ROOT=G:\我的雲端硬碟\claude\LINE
# PROGRESS_INTERVAL_SECONDS=300
# CONFIRM_TIMEOUT_SECONDS=600
# claude 不在 PATH 上時,改填完整路徑。Windows 上 npm 裝的 `claude` 是 .ps1/.cmd
# 包裝層,用 subprocess 直接 spawn 長字串/中文參數時容易被 .cmd 的 %* 轉發搞丟,
# 建議直接指到底層 .exe,例如:
# CLAUDE_CLI_PATH=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
# 一次 LINE 對話(一次 `claude -p` 呼叫)的整體逾時秒數
# CLAUDE_TIMEOUT_SECONDS=1800
# 給 scripts/claude_confirm_hook.py 呼叫用的內部 API base url,留空則自動用 http://127.0.0.1:<PORT>
# INTERNAL_BASE_URL_OVERRIDE=
