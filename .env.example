# Copy this file to .env and adjust values as needed.

APP_NAME=HLAF
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- LINE Messaging API (LINE Developers Console > Messaging API) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Access control ---
# 留空 = 第一個私訊官方帳號的人自動成為管理員(存到 config/allowlist.json)
# 也可直接填 LINE userId,逗號分隔
ALLOWED_LINE_USER_IDS=

# --- Desktop agent (Hermes 操控電腦的工作範圍,大腦是本機已登入的 Claude Code CLI) ---
# HERMES_DESKTOP_ROOT=G:\我的雲端硬碟\Hermes agent
# HERMES_PROGRESS_INTERVAL_SECONDS=300
# HERMES_CONFIRM_TIMEOUT_SECONDS=600
# claude 不在 PATH 上時,改填完整路徑,例如 C:\Users\you\AppData\Roaming\npm\claude.cmd
# CLAUDE_CLI_PATH=claude
# 一次 LINE 對話(一次 `claude -p` 呼叫)的整體逾時秒數
# HERMES_CLAUDE_TIMEOUT_SECONDS=1800
# 給 scripts/claude_hermes_hook.py 呼叫用的內部 API base url,留空則自動用 http://127.0.0.1:<PORT>
# HERMES_INTERNAL_BASE_URL=
