# 複製這份成 .env 並填入真實值。真正的 .env 內容一律不進 git（見 .gitignore）。

# --- LINE Messaging API（總務處群組機器人官方帳號）---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 允許回覆的 LINE 群組 chat ID，逗號分隔。群組內任何成員發言都可觸發回覆；
# 私訊與未列名群組一律靜默忽略。
LINE_ALLOWED_GROUPS=

# 允許私訊的管理員 LINE userId，逗號分隔。私訊這個帳號且 userId 在名單上，
# 會轉給完全不受限的 opencode「admin」代理（可讀寫檔案、跑指令），其餘私訊
# 一律靜默忽略。務必只放你自己的 userId，不要放群組 ID。
LINE_ALLOWED_USERS=

# --- opencode 模型 API 金鑰（依模型鏈實際用到的 provider 增減）---
# opencode/big-pickle、opencode/deepseek-v4-flash-free 走 opencode-zen，金鑰要用
# `opencode auth login -p opencode` 存進 ~/.local/share/opencode/auth.json
# （不是這個 .env），這裡的 OPENCODE_ZEN_API_KEY 只是留底備查。
# OPENCODE_ZEN_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# --- group-bot 專屬設定 ---
GROUPBOT_PORT=8001
GROUPBOT_OPENCODE_BIN=C:\Users\<user>\AppData\Roaming\npm\node_modules\opencode-ai\bin\opencode.exe
# 常駐 opencode serve 的位址(由 scripts/start-group-bot*.ps1 啟動;這個 app 只
# 打 HTTP,不會自己 spawn opencode)。
GROUPBOT_OPENCODE_SERVE_HOST=127.0.0.1
GROUPBOT_OPENCODE_SERVE_PORT=4097
GROUPBOT_OPENCODE_AGENT=groupbot
GROUPBOT_MODEL_CHAIN=opencode/big-pickle,opencode/deepseek-v4-flash-free,openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/deepseek-ai/deepseek-v4-flash,nvidia/z-ai/glm-5.2
GROUPBOT_MODEL_TIMEOUT_SECONDS=45
# 只套用在第一棒(big-pickle)的逾時,免費機會池常常卡住,拖到 45 秒才切下一棒
# 太慢,不代表要換掉主力模型,只是不想死等它。
GROUPBOT_PRIMARY_MODEL_TIMEOUT_SECONDS=20
GROUPBOT_CONTEXT_WINDOW=10

# --- 管理員私訊代理（admin，完整工具權限）---
GROUPBOT_ADMIN_OPENCODE_AGENT=admin
# 務必用一個乾淨、專屬、檔案很少的資料夾——指到大型專案資料夾（尤其是
# Google 雲端硬碟掛載上的）會讓 opencode session 卡死，之後每次呼叫都回
# 0 token 空結果（2026-07-21 實測踩過，外觀看起來像「所有模型都失敗」）。
GROUPBOT_ADMIN_CWD=G:\我的雲端硬碟\opencode\LINE-admin
GROUPBOT_ADMIN_MODEL_TIMEOUT_SECONDS=180

# --- Codex CLI 大腦(2026-07-22,見 app/services/codex_agent.py)---
# 選哪個大腦回覆:opencode(預設,行為不變)或 codex。切換只需要改這一行,
# 兩邊程式碼/人設檔/腳本全部並存、互不影響、隨時能切回去。
GROUPBOT_BRAIN=opencode
GROUPBOT_CODEX_BIN=C:\Users\<user>\AppData\Roaming\npm\codex.cmd
# 不像 opencode serve,codex 沒有常駐伺服器——每則訊息都是獨立 spawn 一次
# `codex exec`,逾時直接砍掉那一個子行程即可,不會影響其他訊息。
GROUPBOT_CODEX_MODEL_CHAIN=gpt-5.4-mini,gpt-5.5
GROUPBOT_CODEX_MODEL_TIMEOUT_SECONDS=45
GROUPBOT_CODEX_PRIMARY_MODEL_TIMEOUT_SECONDS=20
GROUPBOT_CODEX_WORKDIR=C:\Users\<user>\group-bot-scripts\codex-groupbot-workdir

# --- Codex 管理員私訊代理 ---
GROUPBOT_CODEX_ADMIN_MODEL_CHAIN=gpt-5.4-mini,gpt-5.5
GROUPBOT_CODEX_ADMIN_MODEL_TIMEOUT_SECONDS=90
GROUPBOT_CODEX_ADMIN_PRIMARY_MODEL_TIMEOUT_SECONDS=45
GROUPBOT_CODEX_ADMIN_WORKDIR=C:\Users\<user>\codex-admin-workdir
